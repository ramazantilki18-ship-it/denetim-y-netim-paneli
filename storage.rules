rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Yardımcı Fonksiyonlar ───────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*');
    }

    function isUnder15MB() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'Super_Admin', 'superAdmin', 'super_admin', 'Admin']
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('roleId', '') in ['Super_Admin', 'admin', 'superAdmin', 'super_admin', 'Admin']
        );
    }

    // ─── Denetim Fotoğrafları ─────────────────────────────────────────────
    match /audits/{auditId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && isUnder15MB();
      allow delete: if isAdmin();
    }

    // ─── Uygunsuzluk Tespit & Kapatma Fotoğrafları ─────────────────────────
    match /nonconformities/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && isUnder15MB();
      allow delete: if isAdmin();
    }

    // ─── Geri Bildirim Ekleri / Fotoğrafları ──────────────────────────────
    match /feedbacks/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && isUnder15MB();
      allow delete: if isAdmin();
    }

    // ─── Genel / Ekstra Dosya Yüklemeleri ─────────────────────────────────
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isUnder15MB();
      allow delete: if isAdmin();
    }

    // ─── Varsayılan ───────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
